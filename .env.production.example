# =============================================================================
# Production Environment Variables for Render Deployment
# College Management Portal — Laravel 12
#
# INSTRUCTIONS:
#   Do NOT commit the real .env.production file.
#   Copy this file to .env.production, fill in the values, and add them
#   one-by-one in the Render dashboard under:
#   Service → Environment → Add Environment Variable
#
# Generate APP_KEY with:  php artisan key:generate --show
# =============================================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME="College Management Portal"
APP_ENV=production
APP_KEY=                                # !! REQUIRED — generate & set in Render dashboard
APP_DEBUG=false
APP_URL=https://your-service.onrender.com   # Replace with your Render URL or custom domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------
# Database — MySQL (External provider required on Render)
# Recommended providers:
#   - PlanetScale   → https://planetscale.com        (free tier available)
#   - Aiven         → https://aiven.io
#   - Railway       → https://railway.app
#   - TiDB Cloud    → https://tidbcloud.com          (MySQL-compatible)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=                                # e.g. aws.connect.psdb.cloud
DB_PORT=3306
DB_DATABASE=college_portal
DB_USERNAME=                            # set in Render dashboard
DB_PASSWORD=                            # set in Render dashboard

# If your provider uses SSL (PlanetScale does):
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# -------------------------------------------------------
# Session / Cache / Queue
# Using 'database' driver — no external Redis required
# -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# -------------------------------------------------------
# File Storage
# -------------------------------------------------------
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -------------------------------------------------------
# Mail (configure with your mail provider)
# -------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="College Management Portal"

# -------------------------------------------------------
# Deployment Control
# Set to "true" ONLY on first deploy, then set back to "false"
# -------------------------------------------------------
RUN_MIGRATIONS=false
